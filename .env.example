# Placeholders for stage E1 (real Telegraph client). Do not fill in values in this file;
# real values go only in the local .env (it is in .gitignore).
TELEGRAPH_API_URL=
TELEGRAPH_WALLET_KEY=
# Token of the Hash or Lease Telegram bot (from @BotFather). Empty: the bot does not start, the agent runs without notifications.
# Custom name instead of TELEGRAM_BOT_TOKEN, so it does not pick up another bot's token from the machine environment.
HASHORLEASE_BOT_TOKEN=
# Public https URL of the app for the "Open app" / "Open breakdown" buttons in the bot (Telegram does not accept localhost).
APP_URL=
# Daily spend limit for paid Telegraph requests, in $ (default 0.50). Checked before every payment.
DAILY_SPEND_LIMIT_USD=
# live: real data (Telegraph testnet + public sources); empty: demo on made-up data.
NEXT_PUBLIC_DATA_MODE=
