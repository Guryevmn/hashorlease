# Заготовки для этапа Э1 (реальный клиент Telegraph). Значения не заполнять в этом файле,
# настоящие значения — только в локальном .env (он в .gitignore).
TELEGRAPH_API_URL=
TELEGRAPH_WALLET_KEY=
# Токен Telegram-бота Hash or Lease (от @BotFather). Пусто — бот не стартует, агент работает без оповещений.
# Имя своё, а не TELEGRAM_BOT_TOKEN, чтобы не подхватить токен другого бота из окружения машины.
HASHORLEASE_BOT_TOKEN=
# Публичный https-адрес приложения для кнопок «Open app» / «Open breakdown» в боте (localhost Telegram не принимает).
APP_URL=
# Дневной лимит трат на платные запросы Telegraph, $ (по умолчанию 0.50). Проверяется перед каждым платежом.
DAILY_SPEND_LIMIT_USD=
# live — реальные данные (Telegraph testnet + публичные источники); пусто — демо на выдуманных данных.
NEXT_PUBLIC_DATA_MODE=
